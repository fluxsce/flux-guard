# 示例配置。复制为 configs/appside.yaml 后再改。appside.yaml 是本机文件，不要提交。
# 一台机器只装这一个应用代理进程（可与主机代理、Go 代理同机共存，种类不同各占一行）。
# 下面 runtimes 里，一段就是这一台机器上的一套程序。
# 一套 Tomcat 里有好几个网站（WAR）时，只写这一段。网站会从这套的 webapps 里自动找出来，不用逐个写。
#
# mode 是应用类型：tomcat / node / script / jar / static / files。换包规则和 command 默认脚本都按它来。
# kind 是怎么启停：
#   systemd   Linux 系统服务。service 填服务名。
#   windows   Windows 服务。service 填服务名。
#   docker    容器。service 填容器名。
#   command   本机命令。可手写 start / stop / status / restart / kill。
#             tomcat 不写 stop：不执行 shutdown。KillAuto 默认为 true，按完整
#                    -Dcatalina.base=<base> 强杀（不按实例名），再启动。
#                    不写 start 时按常见位置找脚本：base/bin/startup.sh（Windows 为 startup.bat），
#                    没有则依次找 base/bin、base、base/scripts 下的 start.sh（Windows 为 .bat）。
#                    这些文件都不存在时，仍使用 base/bin/startup.sh。
#             tomcat 写了 stop：先执行这支脚本；进程还在再按上面的方式强杀。
#             tomcat 写了 restart：重启只执行这支脚本，不再先强杀。
#             node / script -> 优先用 base/bin、base、base/scripts 下的 start/stop/status，
#                             没有则落到 base/bin/start.sh（Windows 为 .bat）；kill 可手写
#             jar -> 在 jar 同目录找上述约定脚本
#             files -> 不启停；心跳只报站点，文件清单在控制台打开时向代理请求
#             kind=command 会忽略 service（写了也丢弃；systemd/windows/docker 才用 service）
#             stop_grace_sec：写了 stop 时，优雅停止最长秒数（默认 30），超时仍在跑则强杀
#             startup_wait_sec：启动探测最长秒数（Tomcat 默认 180，其它默认 30），按秒轮询日志/进程
#
# tomcat / node / script 填 base。换包或升级都会先挪到 backup_dir，再写回原路径，然后重启。
# files 填 base 为制品目录：心跳只登记这一套运行时；打开/刷新文件仓时向代理要清单
# （中央能拨则短拨；隔离网拨不通则代理出站推清单）。只换文件、不重启。
# 文件移动或删除后点刷新即可。隔离网须代理能访问中央（command_listen 可仅本机）。
#
# 环境变量前缀 FLUX_GUARD，例如 FLUX_GUARD_SERVER_URL 覆盖 server_url。
server_url: http://127.0.0.1:8080 # 中央地址
agent_token: agt_dev_local # 开发令牌，上线前换成环境设置里的上报令牌
interval_sec: 15 # 多久上报一次，单位秒
description: # 可选；写入代理列表「描述」（FG_AGENT.noteText）；非空时每次上报覆盖控制台备注，空则不改
# 中央能拨到本机时填 0.0.0.0:端口或本机网卡 IP；填 127.0.0.1 时中央在其它机器上拨不通，启停/换包会改走代理长轮询（仍可用）。
command_listen: 0.0.0.0:7701 # 中央连这台机器下发命令的端口。整台机器一个。留空则由这台机器自己去中央取命令
backup_dir: /data/fluxguard/backup # 换包和升级前，旧文件挪到这里。必须填写，不要放在 webapps / 制品目录里面。Windows 可写成 E:\fluxguard\backup

runtimes:
  # 系统服务启动的一套 Tomcat。
  - kind: systemd
    instance: tomcat-a # 控制台里显示的这套的名字。同一台机器上不能重名
    service: tomcat-a
    mode: tomcat
    base: /opt/tomcat-a
    description: 生产订单 Tomcat # 可选；写入 fg0008 左侧运行时描述；非空覆盖、空不改
  # 脚本启动的 Tomcat：不写 stop。直接按 -Dcatalina.base=/opt/tomcat-b 强杀，再执行启动脚本。
  - kind: command
    instance: tomcat-b
    mode: tomcat
    base: /opt/tomcat-b
    description: 测试环境 Tomcat
    # start: /opt/tomcat-b/bin/startup.sh
    # 不写 start 时的查找顺序：bin/startup.sh → bin/start.sh → base/start.sh → base/scripts/start.sh
    # stop: /opt/tomcat-b/bin/shutdown.sh
    # 写了 stop 才先走脚本；不写则只强杀。进程还在时仍会强杀。
    # restart: /opt/tomcat-b/bin/restart.sh
    # 写了 restart 时，重启只执行这支脚本。
    # stop_grace_sec: 30      # 可选；仅在写了 stop 时等待脚本结束，超时强杀
    # startup_wait_sec: 300   # 可选；大应用启动探测可加长（默认 180）
    # kill:  # 可选；一般不用手写。默认 KillAuto，按 -Dcatalina.base=<base> 精确强杀
  # Node：换包是 zip 解到 base。启停可手写，也可放约定脚本后自动推导。
  - kind: command
    instance: order-api
    mode: node
    base: /opt/order-api
    description: 订单 API（Node）
  # 通用脚本应用：目录 + start/stop/status，换包同样进 base。
  - kind: command
    instance: batch-job
    mode: script
    base: /opt/batch-job
    # 约定脚本：base/bin/start.sh、stop.sh、status.sh（或放在 base、base/scripts）
  # jar：同目录有约定脚本时可省略 start/stop/status。
  # - kind: command
  #   instance: order-jar
  #   mode: jar
  #   jar: /opt/order/order.jar
  # - kind: systemd
  #   instance: order-static
  #   service: order-static
  #   mode: static
  #   static_app: order-static
  #   static_dir: /data/www/order
  # 发版目录仓：只换文件，不启停。例如 Windows 上的 WAR 包目录。
  - kind: command
    instance: war-v10-p05
    mode: files
    base: E:\war\V10.0.0-P05
    description: 本机 war 制品目录

log:
  file: logs/appside.log
  level: info # 最低级别：debug、info、warn、error。低于此级别的不写
  max_size_mb: 20
  max_backups: 5
  max_age_days: 14
  console: true
