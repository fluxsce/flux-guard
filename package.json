{
  "name": "flux-guard",
  "private": true,
  "scripts": {
    "dev": "node web/node_modules/concurrently/dist/bin/concurrently.js -k -s first -n GO,VITE -c yellow,cyan \"npm:dev:go\" \"npm:dev:vite\"",
    "dev:go": "go run ./cmd/server",
    "dev:vite": "pnpm --dir web run dev",
    "dev:host": "go run ./cmd/host"
  }
}
